{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOoqfqv+r6K0Xw0/dqSq3nE"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"7K4hH75eQTOy"},"outputs":[],"source":[]},{"cell_type":"code","source":["# ==============================\n","# TEXT SUMMARIZATION TOOL\n","# User Provides Text\n","# ==============================\n","\n","# Install library first:\n","# pip install nltk\n","\n","import nltk\n","from nltk.corpus import stopwords\n","from nltk.tokenize import sent_tokenize, word_tokenize\n","from collections import defaultdict\n","import string\n","\n","# Download required files\n","nltk.download('punkt')\n","nltk.download('stopwords')\n","nltk.download('punkt_tab') # Added this line to download the missing resource\n","\n","# Function for summarization\n","def summarize_text(text, num_sentences=2):\n","\n","    stop_words = set(stopwords.words(\"english\"))\n","    words = word_tokenize(text.lower())\n","\n","    # Calculate word frequency\n","    word_freq = defaultdict(int)\n","\n","    for word in words:\n","        if word not in stop_words and word not in string.punctuation:\n","            word_freq[word] += 1\n","\n","    # Split text into sentences\n","    sentences = sent_tokenize(text)\n","\n","    # Score sentences\n","    sentence_scores = defaultdict(int)\n","\n","    for sentence in sentences:\n","        for word in word_tokenize(sentence.lower()):\n","            if word in word_freq:\n","                sentence_scores[sentence] += word_freq[word]\n","\n","    # Select top sentences\n","    summarized_sentences = sorted(\n","        sentence_scores,\n","        key=sentence_scores.get,\n","        reverse=True\n","    )[:num_sentences]\n","\n","    # Final summary\n","    summary = \" \".join(summarized_sentences)\n","\n","    return summary\n","\n","\n","# ==============================\n","# Main Program\n","# ==============================\n","\n","while True:\n","\n","    print(\"\\nEnter your text:\")\n","    user_text = input()\n","\n","    summary = summarize_text(user_text)\n","\n","    print(\"\\nSummary:\")\n","    print(summary)\n","\n","    # Ask user to continue\n","    choice = input(\"\\nDo you want to summarize another text? (yes/no): \")\n","\n","    if choice.lower() != \"yes\":\n","        print(\"\\nThank You!\")\n","        break"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Rp2Yr__XmcD3","executionInfo":{"status":"ok","timestamp":1778512617341,"user_tz":-330,"elapsed":11090,"user":{"displayName":"Khushi Sharnagat","userId":"01754248704709198008"}},"outputId":"2c0fa007-9640-4cc9-a7df-9f128eaaed92"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stderr","text":["[nltk_data] Downloading package punkt to /root/nltk_data...\n","[nltk_data]   Package punkt is already up-to-date!\n","[nltk_data] Downloading package stopwords to /root/nltk_data...\n","[nltk_data]   Package stopwords is already up-to-date!\n","[nltk_data] Downloading package punkt_tab to /root/nltk_data...\n","[nltk_data]   Package punkt_tab is already up-to-date!\n"]},{"output_type":"stream","name":"stdout","text":["\n","Enter your text:\n","The presentation of the dessert and the clean, minimalist background create a sense of elegance and sophistication. It looks delicious and professionally plated.\n","\n","Summary:\n","The presentation of the dessert and the clean, minimalist background create a sense of elegance and sophistication. It looks delicious and professionally plated.\n","\n","Do you want to summarize another text? (yes/no): yes\n","\n","Enter your text:\n","The presentation of the dessert and the clean, minimalist background create a sense of elegance and sophistication. It looks delicious and professionally plated.\n","\n","Summary:\n","The presentation of the dessert and the clean, minimalist background create a sen